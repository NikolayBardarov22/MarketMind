@{
	ViewData["Title"] = "Home";
}

<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<div class="container mt-5 welcome-section">
	<div class="row justify-content-center">
		<div class="col-md-8 col-sm-10 text-center">
			<h1 class="display-4">Welcome to Market Mind</h1>
			<p class="lead">Discover stocks, trends, and market opportunities</p>
			<a href="/Identity/Account/Register" class="btn btn-primary btn-lg mt-3">
				Start Your Journey
			</a>
		</div>
	</div>
</div>

<div class="container mt-4 explore-section">
	<h2 class="text-center section-title">Explore the Market</h2>
	<div class="row mt-4 justify-content-center">
		
		<div class="col-lg-4 col-md-6 mb-4">
			
			<div class="feature-card text-center">
				<img src="https://www.investopedia.com/thmb/YIF25WvuSRyKuojSVk9UYcSy6Ao=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/GettyImages-1158402857-7bb1f36833e44ad496955b8fb2161ffd.jpg"
					 class="stock-img"
					 alt="Growth Stocks">
				<h5 class="mt-3">Growth Stocks</h5>
				<p>Identify fast-growing companies with strong future potential.</p>
			</div>
		</div>

		
		<div class="col-lg-4 col-md-6 mb-4">
		
			<div class="feature-card text-center">
				<img src="https://fxmedia.s3.amazonaws.com/articles/financial_market_trends.png"
					 class="stock-img"
					 alt="Market Trends">
				<h5 class="mt-3">Market Trends</h5>
				<p>Analyze market movements, trends, and sector performance.</p>
			</div>
		</div>

		
		<div class="col-lg-4 col-md-6 mb-4">
			
			<div class="feature-card text-center">
				<img src="https://cdn.bullionexchanges.com/cdn-cgi/image/width=1050,height=480,quality=60,format=auto/media/wysiwyg3/Blog/BE_blog_diversify_2026_121025.jpg"
					 class="stock-img"
					 alt="Smart Diversification">
				<h5 class="mt-3">Smart Diversification</h5>
				<p>Build balanced portfolios and manage investment risk effectively.</p>
			</div>
		</div>

	</div>
</div>
