@model MarketMind.Web.ViewModels.Stock.StockDetailsViewModel

@{
    ViewData["Title"] = Model.Name + " Details";
}

<div class="container stock-details-page">

    <!-- === ГЛАВНА ИНФОРМАЦИЯ ЗА АКЦИЯТА === -->
    <div class="stock-header">
        <div class="stock-header-info">
            <h1 class="display-4">@Model.Name</h1>
            <p class="lead text-muted symbol-badge">@Model.Symbol</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="stock-header-img" alt="@Model.Name logo">
        }
    </div>

    <hr class="my-4" />

    <div class="row">
        <!-- === КОЛОНА ЗА НОВИНИ === -->
        <div class="col-lg-7">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3>Latest News</h3>

                @* Този бутон ще се вижда САМО ако потребителят е в роля "Admin" *@
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="StockNews" asp-action="Add" asp-route-stockId="@Model.Id" class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-plus"></i> Add News
                    </a>
                }
            </div>

            @* Проверяваме дали има новини, преди да опитаме да ги покажем *@
            @if (Model.StockNews.Any())
            {
                foreach (var newsItem in Model.StockNews.OrderByDescending(n => n.PublishedOn))
                {
                    <div class="card mb-3 news-analysis-card">
                        <div class="card-body">
                            <h5 class="card-title">@newsItem.Title</h5>
                            <p class="card-text text-muted small">
                                By @newsItem.AuthorName on @newsItem.PublishedOn.ToString("MMMM dd, yyyy")
                            </p>
                            @if (!string.IsNullOrEmpty(newsItem.ImageUrl))
                            {
                                <img src="@newsItem.ImageUrl" class="img-fluid rounded my-2 news-item-img" alt="News Image">
                            }
                            <p class="card-text">@newsItem.Content</p>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-info">
                    No news available for this stock at the moment.
                </div>
            }
        </div>

        <!-- === КОЛОНА ЗА АНАЛИЗИ === -->
        <div class="col-lg-5">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3>Analysis</h3>

                @* И този бутон е само за админи *@
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="StockAnalysis" asp-action="Add" asp-route-stockId="@Model.Id" class="btn btn-sm btn-outline-success">
                        <i class="fas fa-plus"></i> Add Analysis
                    </a>
                }
            </div>

            @if (Model.StockAnalysis.Any())
            {
                foreach (var analysisItem in Model.StockAnalysis)
                {
                    <div class="card mb-3 news-analysis-card">
                        <div class="card-body">
                            <h5 class="card-title">@analysisItem.Title</h5>
                            <p class="card-text text-muted small">
                                By @analysisItem.AuthorName
                            </p>
                            <p class="card-text">@analysisItem.Content</p>
                            <hr />
                            <div class="d-flex justify-content-between text-center">
                                <div>
                                    <small class="text-muted">Recommendation</small>
                                    <span class="badge recommendation-badge bg-primary">@analysisItem.Recommendation.ToString()</span>
                                </div>
                                <div>
                                    <small class="text-muted">Risk Level</small>
                                    <span class="badge risk-level-badge bg-danger">@analysisItem.RiskLevel.ToString()</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-info">
                    No analysis available for this stock at the moment.
                </div>
            }
        </div>
    </div>
</div>

@* Този CSS може да го добавите тук за бърз тест или, още по-добре,
   да го преместите във вашия wwwroot/css/site.css файл *@
<style>
    .stock-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 1rem;
    }

    .stock-header-img {
        max-height: 80px;
        border-radius: 8px;
    }

    .symbol-badge {
        font-size: 1.5rem;
        font-weight: 300;
        background-color: #e9ecef;
        padding: 0.25rem 0.75rem;
        border-radius: 5px;
        display: inline-block;
    }

    .news-analysis-card {
        border-left: 4px solid #0d6efd; /* Син акцент за новини */
        transition: box-shadow 0.2s ease-in-out;
    }

    .col-lg-5 .news-analysis-card {
        border-left-color: #198754; /* Зелен акцент за анализи */
    }

    .news-analysis-card:hover {
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .news-item-img {
        max-height: 250px;
        width: 100%;
        object-fit: cover;
    }

    .recommendation-badge, .risk-level-badge {
        font-size: 0.9rem;
        font-weight: 500;
        padding: 0.5em 0.75em;
        width: 80px; /* Фиксирана ширина за по-добро подравняване */
    }
</style>